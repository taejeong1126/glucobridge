{
    "name": "caresens-auth-helper",
    "version": "0.1.0",
    "private": true,
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "main": "src/main.mjs",
    "scripts": {
        "start": "electron .",
        "check": "node --check src/main.mjs && node --check src/caresens-auth.mjs && node --check src/renderer.js && node --check src/preload.cjs",
        "build:portable": "electron-builder --win portable --x64"
    },
    "devDependencies": {
        "electron": "^38.0.0",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "app.glucobridge.caresens",
        "productName": "CareSens Connect",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*"
        ],
        "win": {
            "target": "portable",
            "artifactName": "${productName}-${version}-portable.${ext}"
        }
    }
}
